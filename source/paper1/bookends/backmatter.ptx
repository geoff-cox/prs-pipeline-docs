<backmatter xmlns:xi="http://www.w3.org/2001/XInclude" xml:id="backmatter">
	<title>Supplementary Structure</title>

	<appendix xml:id="app-notation">
		<title>Notation Summary</title>

		<table xml:id="tab-notation">
			<title>Notation used in the framework.</title>
			<tabular halign="center">
				<col width="20%" />
				<col width="70%" halign="left"/>
				<row header="yes">
						<cell>Symbol</cell>
						<cell>Meaning</cell>
				</row>
				<row>
						<cell><m>P</m></cell>
						<cell>Number of cards in an item</cell>
				</row>
				<row>
						<cell><m>R</m></cell>
						<cell>Number of destination zones, excluding the tray</cell>
				</row>
				<row>
						<cell><m>\cardset</m></cell>
						<cell>Card set</cell>
				</row>
				<row>
						<cell><m>\zoneset</m></cell>
						<cell>Tray and destination-zone set</cell>
				</row>
				<row>
						<cell><m>\statespace</m></cell>
						<cell>Admissible state space</cell>
				</row>
				<row>
						<cell><m>X</m></cell>
						<cell>Response state</cell>
				</row>
				<row>
						<cell><m>X^\star</m></cell>
						<cell>Unique correct state, when applicable</cell>
				</row>
				<row>
						<cell><m>e_k</m></cell>
						<cell>Event at ordinal position <m>k</m></cell>
				</row>
				<row>
						<cell><m>t_k</m></cell>
						<cell>Timestamp associated with event <m>e_k</m></cell>
				</row>
				<row>
						<cell><m>\trajectory</m></cell>
						<cell>Marked timestamped state trajectory</cell>
				</row>
			</tabular>
		</table>

