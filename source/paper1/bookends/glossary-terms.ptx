<?xml version="1.0" encoding="UTF-8"?>

<!-- Terminology glossary for main.ptx (group-facing).                          -->
<!-- Self-contained: no cross-references into the private journal, and no       -->
<!-- mathematical notation (that lives in the journal's appendix-notation).          -->
<!-- Item ids use the gt- prefix. Generous first draft; prune freely.           -->
<glossary xml:id="sec-glossary-terms">
  <title>Glossary of Terms</title>

  <headnote>
    <p>
      This glossary collects the working vocabulary used in the first part of
      the drag-and-drop study: the authored <tag>cardsort</tag> item, the
      objects and zones on the board, the raw event data, and the state model
      used to represent board configurations. It is intended for general
      discussion, so detailed mathematical notation is kept to the main text.
    </p>
  </headnote>

  <gi xml:id="gt-action">
    <title>action</title>
    <p>
      A logged student interaction with the drag-and-drop board: a move, check,
      or reset. Page views are recorded in the raw data but are not board
      actions.
    </p>
  </gi>

  <gi xml:id="gt-attempt">
    <title>attempt</title>
    <p>
      A student's work on a particular problem within a session, represented by
      the ordered actions and configurations produced while interacting with the
      board.
    </p>
  </gi>

  <gi xml:id="gt-board">
    <title>board</title>
    <p>
      The drag-and-drop interface the student works in: the tray, authored
      slots, cards, and check and reset controls.
    </p>
  </gi>

  <gi xml:id="gt-card">
    <title>card</title>
    <p>
      A draggable object in a <tag>cardsort</tag>. Cards are authored as
      <tag>premise</tag> elements and recorded in the raw data by positional
      labels such as <c>drag1</c>, <c>drag2</c>, and so on.
    </p>
  </gi>

  <gi xml:id="gt-cardsort">
    <title>cardsort</title>
    <p>
      The auto-graded drag-and-drop question type studied here. In <pretext/>,
      a <tag>cardsort</tag> is authored from <tag>match</tag> blocks containing
      draggable <tag>premise</tag> elements and labeled <tag>response</tag>
      elements.
    </p>
  </gi>

  <gi xml:id="gt-check">
    <title>check</title>
    <p>
      The action of pressing the <q>check</q> button. A check moves no card; it
      records the current configuration and returns feedback based on the key
      and feedback policy.
    </p>
  </gi>

  <gi xml:id="gt-check-gap">
    <title>check gap</title>
    <p>
      The elapsed time between consecutive check actions, computed from raw-data
      timestamps.
    </p>
  </gi>

  <gi xml:id="gt-configuration">
    <title>configuration</title>
    <p>
      A board state described by the current zone of every card. In this
      project, <em>state</em> and <em>configuration</em> refer to the same
      mathematical object; <em>configuration</em> emphasizes the card-to-zone
      assignment.
    </p>
  </gi>

  <gi xml:id="gt-configuration-function">
    <title>configuration function</title>
    <p>
      The representation of a configuration as a rule assigning each card to
      its current zone.
    </p>
  </gi>

  <gi xml:id="gt-configuration-space">
    <title>configuration space</title>
    <p>
      The set of all valid configurations for an item. In a standard
      <tag>cardsort</tag>, each card may occupy any zone, including the tray.
    </p>
  </gi>

  <gi xml:id="gt-configuration-vector">
    <title>configuration vector</title>
    <p>
      The representation of a configuration as an ordered list of zone indices,
      one for each card in source order. A single-card move changes exactly one
      coordinate.
    </p>
  </gi>

  <gi xml:id="gt-decoy-card">
    <title>decoy card</title>
    <p>
      A card whose home zone is the tray. A decoy card should remain unplaced;
      moving it into an authored slot is incorrect with respect to that card.
    </p>
  </gi>

  <gi xml:id="gt-decoy-card-leak">
    <title>decoy-card leak</title>
    <p>
      A structural error in which a decoy card is moved out of the tray and into
      an authored slot. This should not automatically be interpreted as a
      misconception.
    </p>
  </gi>

  <gi xml:id="gt-decoy-slot">
    <title>decoy slot</title>
    <p>
      An authored slot that should be empty in the key. Placing any card into a
      decoy slot is incorrect with respect to that slot.
    </p>
  </gi>

  <gi xml:id="gt-decoy-slot-leak">
    <title>decoy-slot leak</title>
    <p>
      A structural error in which a card is placed into a decoy slot. This
      identifies a feature of the configuration, not by itself a specific
      misconception.
    </p>
  </gi>

  <gi xml:id="gt-distance">
    <title>distance</title>
    <p>
      A measure of how many card assignments differ between two configurations.
      Distance from the key counts the cards not currently in their home zones.
      For a standard <tag>cardsort</tag>, it is also the minimum number of
      direct single-card moves needed to reach the key state.
    </p>
  </gi>

  <gi xml:id="gt-dragzone">
    <title>dragzone</title>
    <p>
      The tray area where every card begins. The dragzone is a zone but not an
      authored slot, and it is recorded in the raw data as <c>dragzone</c>.
    </p>
  </gi>

  <gi xml:id="gt-event">
    <title>event</title>
    <p>
      An event is any change in the state of the system. It corresponds to a 
      logged row in the raw data, and has a timestamp, an action type, and an 
      action payload. Moves, checks, resets, and page views are all events.
    </p>
  </gi>

  <gi xml:id="gt-feedback">
    <title>feedback</title>
    <p>
      The information returned when a student checks an answer. In the raw data,
      check rows include feedback fields such as <c>Feedback Text</c> and
      <c>Feedback Classification</c>.
    </p>
  </gi>

  <gi xml:id="gt-feedback-policy">
    <title>feedback policy</title>
    <p>
      The item-level rule governing checks: when feedback is available, what
      information is returned, and whether checks are limited, delayed,
      penalized, or freely available.
    </p>
  </gi>

  <gi xml:id="gt-homezone">
    <title>home zone</title>
    <p>
      The zone where a card belongs according to the key. A card whose home zone
      is the tray is a decoy card.
    </p>
  </gi>

  <gi xml:id="gt-initial-state">
    <title>initial state</title>
    <p>
      The state at the start of a problem and after a reset: every card in the
      tray and every authored slot empty.
    </p>
  </gi>

  <gi xml:id="gt-item-design">
    <title>item design</title>
    <p>
      The authored structure of a <tag>cardsort</tag> item before student
      interaction: cards, slots, tray, key, decoys, and feedback policy. Item
      design describes the task environment, not student performance.
    </p>
  </gi>

  <gi xml:id="gt-item-map">
    <title>item map</title>
    <p>
      A data dictionary connecting positional labels such as <c>drag1</c> and
      <c>drop2</c> to the authored card and slot text.
    </p>
  </gi>

  <gi xml:id="gt-key">
    <title>key</title>
    <p>
      The authored correct assignment of each card to its home zone. In a
      <tag>cardsort</tag>, every card has a unique home zone determined by the
      <tag>match</tag> structure.
    </p>
  </gi>

  <gi xml:id="gt-key-occupancy">
    <title>key occupancy</title>
    <p>
      The occupancy pattern of the key state: how many cards are intended to be
      in the tray and in each authored slot.
    </p>
  </gi>

  <gi xml:id="gt-key-state">
    <title>key state</title>
    <p>
      The configuration determined by the key. A check is correct exactly when
      the checked configuration agrees with the key state.
    </p>
  </gi>

  <gi xml:id="gt-match">
    <title>match</title>
    <p>
      A <pretext/> block inside a <tag>cardsort</tag>. A match with premises and
      a response assigns those cards to that slot. A match with a premise but no
      response defines a decoy card; a match with a response but no premise
      defines a decoy slot.
    </p>
  </gi>

  <gi xml:id="gt-membership-matrix">
    <title>membership matrix</title>
    <p>
      A zero-one matrix representation of a configuration, with one row per zone
      and one column per card. Each column has exactly one entry equal to one,
      marking the card's current zone.
    </p>
  </gi>

  <gi xml:id="gt-move">
    <title>move</title>
    <p>
      The action of dragging one card from one zone to another. In the raw data,
      moves are recorded as <c>dragNdrop-drop</c> rows.
    </p>
  </gi>

  <gi xml:id="gt-move-gap">
    <title>move gap</title>
    <p>
      The elapsed time between consecutive move actions, computed from raw-data
      timestamps.
    </p>
  </gi>

  <gi xml:id="gt-occupied-zone">
    <title>occupied zone</title>
    <p>
      A zone containing at least one card. The number of occupied zones
      describes how spread out the cards are, not whether the configuration is
      correct.
    </p>
  </gi>

  <gi xml:id="gt-occupancy">
    <title>occupancy</title>
    <p>
      The count of how many cards are in each zone at a given state. In the
      membership-matrix representation, occupancy is obtained from row sums.
    </p>
  </gi>

  <gi xml:id="gt-omission">
    <title>omission</title>
    <p>
      A type of error where a card is left in the tray when it should be placed. For example,
      a card that was incorrectly identified as a decoy is an omission.
    </p>
  </gi>
  
  <gi xml:id="gt-page-view">
    <title>page view</title>
    <p>
      A raw-data row indicating that the student opened or viewed the page. Page
      views help delimit sessions and problem access, but are not board actions.
    </p>
  </gi>

  <gi xml:id="gt-placed">
    <title>placed, unplaced</title>
    <p>
      A card is <em>placed</em> when it is in an authored slot and
      <em>unplaced</em> when it is in the tray.
    </p>
  </gi>

  <gi xml:id="gt-positional-labels">
    <title>positional labels</title>
    <p>
      The generic raw-data labels for cards and slots, such as <c>drag1</c>,
      <c>drag2</c>, <c>drop1</c>, and <c>drop2</c>. They are based on source
      order rather than visible item text.
    </p>
  </gi>

  <gi xml:id="gt-premise">
    <title>premise</title>
    <p>
      The PreTeXt <tag>premise</tag> element that defines a draggable card in a
      <tag>cardsort</tag>.
    </p>
  </gi>

  <gi xml:id="gt-rank">
    <title>rank</title>
    <p>
      For a valid membership matrix, the rank equals the number of occupied
      zones. Here rank describes spread, not correctness.
    </p>
  </gi>

  <gi xml:id="gt-raw-data">
    <title>raw data</title>
    <p>
      The exported Runestone/DataShop event table, with rows for logged actions
      and page events. It records timestamps, identifiers, problem names, action
      types, action contents, check configurations, and feedback classifications.
    </p>
  </gi>

  <gi xml:id="gt-reset">
    <title>reset</title>
    <p>
      The action of pressing the <q>reset</q> button. A reset returns the board
      to the initial state.
    </p>
  </gi>

  <gi xml:id="gt-response">
    <title>response</title>
    <p>
      The PreTeXt <tag>response</tag> element that defines an authored slot in a
      <tag>cardsort</tag>.
    </p>
  </gi>

  <gi xml:id="gt-session">
    <title>session</title>
    <p>
      A continuous sitting in which a student works on course material. Session
      identifiers help distinguish work done in one sitting from work resumed
      later.
    </p>
  </gi>

  <gi xml:id="gt-slot">
    <title>slot</title>
    <p>
      An authored response area into which cards may be dropped. Slots are
      authored as <tag>response</tag> elements and recorded by labels such as
      <c>drop1</c>, <c>drop2</c>, and so on. A slot is a zone, but the tray is
      not a slot.
    </p>
  </gi>
	
	<gi xml:id="gt-solved">
		<title>solved</title>
		<p>
			Reaching the <xref ref="gt-key" text="custom">key</xref>: a <xref ref="gt-check" text="custom">check</xref> the platform grades Correct.
		</p>
	</gi>

  <gi xml:id="gt-source-order">
    <title>source order</title>
    <p>
      The order in which cards and slots appear in the <tag>cardsort</tag>
      source. Source order determines raw-data labels such as <c>drag1</c> and
      <c>drop1</c>.
    </p>
  </gi>

  <gi xml:id="gt-state">
    <title>state</title>
    <p>
      A snapshot of the board at one moment. A state records where every card
      is, but not the history, feedback, or timing that produced it.
    </p>
  </gi>

  <gi xml:id="gt-takeback">
    <title>takeback</title>
    <p>
      A move whose destination is the dragzone, returning a card from an
      authored slot to the tray.
    </p>
  </gi>

  <gi xml:id="gt-tray">
    <title>tray</title>
    <p>
      The informal name for the dragzone. See
      <xref ref="gt-dragzone" text="title"/>.
    </p>
  </gi>

  <gi xml:id="gt-trajectory">
    <title>trajectory</title>
    <p>
      The ordered path of a student's work through board states and logged
      actions, including moves, checks, resets, and timing information.
    </p>
  </gi>

  <gi xml:id="gt-valid-state">
    <title>valid state</title>
    <p>
      A board state in which every card occupies exactly one zone. In a
      membership matrix, each card column has exactly one entry equal to one.
    </p>
  </gi>

  <gi xml:id="gt-zone">
    <title>zone</title>
    <p>
      Any place a card can rest: either an authored slot or the tray. The state
      model assigns every card to exactly one zone.
    </p>
  </gi>
</glossary>