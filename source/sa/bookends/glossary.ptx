<?xml version="1.0" encoding="UTF-8"?>

<!--
  Glossary for the PROTEUS automation tool documentation.
  Place inside <backmatter> or use as a standalone division.

  Reference any entry from running text via <xref ref="an-..." text="title"/>.
  In HTML output, this produces a clickable knowl that reveals the entry
  inline.

  Entries are grouped thematically in this source file for ease of
  maintenance. PreTeXt will render them in source order; if you want
  alphabetical rendering, re-order or rely on the publisher's
  alphabetize option.
-->

<glossary xml:id="glossary-main">
  <title>Glossary: Framework</title>

  <headnote>
    <p>
      This glossary defines the central theoretical, analytic, and
      computational terms used in the project. The definitions are written for
      new student researchers and describe how each term is used within this
      guide.
    </p>

    <p>
      Some terms come from the cK&#162; framework, while others were introduced
      by this project to support the analysis of short written responses. The
      source of a term matters:
      <ul>
        <li>
          <term>cK&#162; terms</term> describe the broader theoretical model of
          mathematical knowing;
        </li>
        <li>
          <term>Episode Model terms</term> describe the local justification
          extracted from one written response; and
        </li>
        <li>
          <term>pipeline terms</term> describe how the computational tool
          organizes and supports the analysis.
        </li>
      </ul>
    </p>
  </headnote>

  <!-- ============================================================ -->
  <!-- Project-specific names                                       -->
  <!-- ============================================================ -->

  <gi xml:id="an-proteus">
    <title>PROTEUS</title>
    <p>
      The collaborative research project this tool is built for. PROTEUS
      analyzes student interaction data from interactive open-source
      mathematics textbooks, with a focus on understanding how students
      reason through linear-algebra and calculus problems.
    </p>
  </gi>

  <gi xml:id="an-runestone">
    <title>Runestone</title>
    <p>
      The hosting platform that delivers PROTEUS's interactive textbooks
      to students and records their interactions with embedded questions.
      Runestone is the primary source of the short-answer responses this
      tool processes.
    </p>
  </gi>

  <gi xml:id="an-pretext">
    <title>PreTeXt</title>
    <p>
      The authoring framework used to write PROTEUS's textbooks. PreTeXt
      source compiles to HTML, PDF, and other formats and is the source
      format of this report.
    </p>
  </gi>

  <gi xml:id="an-datashop">
    <title>DataShop</title>
    <p>
      A learning-data repository format and platform. PROTEUS exports
      Runestone interaction logs in DataShop's tab-separated format
      (extension <c>.tab</c>) so that the data can be analyzed alongside
      datasets from other learning platforms. The pipeline's
      <xref ref="an-stage-1" text="title"/> stage reads this format directly.
    </p>
  </gi>

  <gi xml:id="an-ckc">
    <title>cK¢ model</title>
    <p>
      Balacheff's <em>conception, knowing, concept</em> model: a
      theoretical framework for describing student conceptions as a
      four-component tuple (problems, operators, representation systems,
      <xref ref="an-control-structure" text="title"/>s). Used in PROTEUS
      to organize how student responses are coded.
    </p>
  </gi>

  <gi xml:id="an-control-structure">
    <title>Control structure (CS)</title>
    <p>
      One component of the <xref ref="an-ckc" text="title"/>. A control structure
      describes the criterion or rule a student uses to recognize that
      they have reached a settled answer. In the pivot-question
      <xref ref="an-codebook" text="title"/> these are coded <c>CS1</c> through
      <c>CS10</c>; the names and definitions of the codes are subject to
      group revision.
    </p>
  </gi>

  <gi xml:id="an-codebook">
    <title>Codebook</title>
    <p>
      The reference document that defines the
      <xref ref="an-control-structure" text="title"/>s used to code
      student responses. Each codebook entry lists a name, a description,
      and a set of keywords that signal its presence in a response. In
      the pipeline, the codebook lives in the database with version
      tracking, so historical codes remain interpretable when the
      codebook evolves.
    </p>
  </gi>
  <gi xml:id="an-codebook0">
    <title>Codebook</title>

    <p>
      A structured guide for classifying the mathematical reasoning found
      in responses. A codebook typically contains:
      <ul>
        <li>code identifiers and names;</li>
        <li>definitions;</li>
        <li>inclusion and exclusion rules;</li>
        <li>positive examples;</li>
        <li>near-miss examples;</li>
        <li>confusable codes; and</li>
        <li>question-specific information when needed.</li>
      </ul>
    </p>
  </gi>
  <!-- ============================================================ -->
  <!-- Episode Model terms                                          -->
  <!-- ============================================================ -->

  <gi xml:id="an-episode">
    <title>Episode</title>
    <p>
      The primary analytic object of the Episode Model: one local trace
      of justification read from a response, written
      <m>e_k = (C_k, I_k, J_k)</m> &#8212;
      <xref ref="an-criterion" text="title"/>,
      <xref ref="an-inferential-link" text="title"/>,
      <xref ref="an-judgment" text="title"/>, in that order. An episode
      is a visible trace of justification, not a claim that a conception
      has been observed. In the database an episode is carried by a
      <xref ref="an-chain-step" text="title"/>.
    </p>
  </gi>

  <gi xml:id="an-inferential-link">
    <title>Inferential link</title>
    <p>
      The <m>I</m> of an <xref ref="an-episode" text="title"/>: the
      inference connecting the cited
      <xref ref="an-criterion" text="title"/> to the
      <xref ref="an-judgment" text="title"/> drawn from it. The
      per-question set of valid links backs the second correctness digit
      and is stored in <c>question_controls.normative_link</c>. An
      episode whose link or judgment is missing is incomplete; it is
      flagged <q>link not satisfied</q> and routed to a human rather
      than scored.
    </p>
  </gi>

  <gi xml:id="an-judgment">
    <title>Judgment</title>
    <p>
      The <m>J</m> of an <xref ref="an-episode" text="title"/>: the
      verdict the student draws from the cited criterion (e.g.,
      <q>one variable is free</q>, <q>the solution is not unique</q>).
      Carried by the <em>conclusion</em> of a
      <xref ref="an-chain-step" text="title"/>.
    </p>
  </gi>

  <!-- ============================================================ -->
  <!-- Mathematics terminology used in examples                     -->
  <!-- ============================================================ -->

  <gi xml:id="an-rref">
    <title>RREF (reduced row echelon form)</title>
    <p>
      A canonical form for a matrix in which each leading entry is 1,
      each leading 1 is the only nonzero entry in its column, and each
      leading 1 lies strictly to the right of the one above. Many
      student responses to the pivot question reference RREF directly
      or implicitly.
    </p>
  </gi>

  <gi xml:id="an-pivot">
    <title>Pivot</title>
    <p>
      A leading nonzero entry in a row of a matrix in echelon or reduced
      echelon form. The number and location of pivots determine the
      consistency and solution-set cardinality of a linear system &#x2014;
      a fact several pipeline codebook entries are organized around.
    </p>
  </gi>

  <gi xml:id="an-free-variable">
    <title>Free variable</title>
    <p>
      A variable in a linear system whose corresponding column in
      <xref ref="an-rref" text="title"/> contains no <xref ref="an-pivot" text="title"/>. The
      existence of a free variable in a consistent system implies
      infinitely many solutions; the absence of a free variable rules
      out non-uniqueness.
    </p>
  </gi>

  <!-- ============================================================ -->
  <!-- THEORETICAL TERMS                                             -->
  <!-- ============================================================ -->

  <gi xml:id="glossary-conception">
    <title>Conception</title>

    <p>
      In the cK&#162; framework, a situated form of mathematical knowing
      modeled by
      <md>
        (P,R,L,\Sigma).
      </md>
      A conception describes a relationship among a class of problems,
      available operators, a representation system, and a control
      structure.
    </p>

    <p>
      A conception is not simply a fixed belief stored inside a student.
      It describes knowing as it functions within particular mathematical
      situations.
    </p>
  </gi>

  <gi xml:id="glossary-knowing">
    <title>Knowing</title>

    <p>
      A person's situated mathematical understanding as it functions in
      interaction with a problem environment. In the cK&#162; tradition,
      <term>knowing</term> is distinguished from publicly recognized
      mathematical <term>knowledge</term>.
    </p>
  </gi>

  <gi xml:id="glossary-problem-class">
    <title>Problem Class, <m>P</m></title>

    <p>
      The collection of problems or situations that a conception can
      successfully address. In the quadruplet <m>(P,R,L,\Sigma)</m>, the
      component <m>P</m> identifies the sphere of problems for which the
      conception is useful.
    </p>
  </gi>

  <gi xml:id="glossary-operator">
    <title>Operator, <m>R</m></title>

    <p>
      A mathematical action used to work on a problem or transform a
      representation. Examples include row reducing a matrix,
      differentiating a function, substituting into an equation, or
      rearranging a symbolic expression.
    </p>

    <p>
      In Balacheff's notation, <m>R</m> denotes operators, not
      representations.
    </p>
  </gi>

  <gi xml:id="glossary-representation-system">
    <title>Representation System, <m>L</m></title>

    <p>
      The linguistic, symbolic, graphical, or technological means through
      which mathematical actions, results, and feedback are expressed.
      Examples include equations, matrices, diagrams, written language,
      and mathematical software interfaces.
    </p>
  </gi>

  <gi xml:id="glossary-control-structure">
    <title>Control Structure, <m>\Sigma</m></title>

    <p>
      The means used to make choices, evaluate actions, validate results,
      and decide whether a mathematical task has been completed.
    </p>

    <p>
      A control structure is broader than one criterion in one response.
      For example, a student may enact a free-variable control by
      recognizing that a free variable exists and using that fact to judge
      whether a solution is unique.
    </p>
  </gi>

  <gi xml:id="glossary-operation">
    <title>Operation</title>

    <p>
      A mathematical action that creates or transforms an object. Examples
      include computing a derivative, row reducing a matrix, solving an
      equation, or constructing a parametric solution.
    </p>

    <p>
      The project distinguishes an operation from a control: an operation
      produces or transforms something, while a control evaluates a feature
      and supports a decision. The distinction can occasionally be
      ambiguous and is treated as a project coding convention.
    </p>
  </gi>

  <gi xml:id="glossary-control">
    <title>Control</title>

    <p>
      An enacted evaluative move that interprets a feature of the current
      mathematical state and supports a judgment. For example, recognizing
      that a matrix has no contradictory row and concluding that the system
      is consistent is a control.
    </p>
  </gi>

  <gi xml:id="glossary-question-frame">
    <title>Question-Level Analytic Frame, <m>K_q</m></title>

    <p>
      The project's question-specific version of the cK&#162; quadruplet:
      <md>
        K_q=(P_q,R_q,L_q,\Sigma_q).
      </md>
      It records the relevant problem context, operations,
      representations, and controls for a particular question <m>q</m>.
    </p>

    <p>
      The frame describes the mathematical context used to analyze the
      response. It is not treated as the student's complete conception.
    </p>

    <p>
      In the tool, the part of this frame that does concrete work is stored
      as the question's <term>working codebook</term>: the control
      structures in scope for the question, each bound to the
      criterion-to-judgment link that is valid for it. That stored
      selection, not a full per-question quadruplet, is what the matching
      and correctness stages consult.
    </p>
  </gi>

  <!-- ============================================================ -->
  <!-- EPISODE MODEL TERMS                                           -->
  <!-- ============================================================ -->

  <gi xml:id="glossary-episode-model">
    <title>Episode Model</title>

    <p>
      The project-developed framework for representing local pieces of
      justification in short written responses. It is motivated by the
      cK&#162; framework but is not itself part of Balacheff's original
      model.
    </p>
  </gi>

  <gi xml:id="glossary-episode-sequence">
    <title>Episode Sequence, <m>E(x)</m></title>

    <p>
      The ordered collection of episodes extracted from a response
      <m>x</m>:
      <md>
        E(x)=\langle e_1,e_2,\ldots,e_n\rangle.
      </md>
      The order usually follows the development of the reasoning in the
      written response.
    </p>
  </gi>

  <gi xml:id="glossary-episode">
    <title>Episode, <m>e_k</m></title>

    <p>
      A local piece of justification represented as
      <md>
        e_k=(C_k,I_k,J_k),
      </md>
      where <m>C_k</m> is a criterion, <m>I_k</m> is an inferential link,
      and <m>J_k</m> is a judgment.
    </p>

    <p>
      An episode is evidence visible in a response. It is not a complete
      model of the student's conception or thought process.
    </p>
  </gi>

  <gi xml:id="glossary-criterion">
    <title>Criterion, <m>C_k</m></title>

    <p>
      The observation, fact, condition, intermediate result, or
      mathematical feature cited in an episode. Examples include:
      <ul>
        <li>a free variable exists;</li>
        <li>there are fewer pivots than variables;</li>
        <li>the derivative is positive; or</li>
        <li>the reduced matrix contains no contradictory row.</li>
      </ul>
    </p>

    <p>
      A criterion is not identical to a control structure. It is the
      particular condition recognized when a broader control is enacted in
      a response.
    </p>
  </gi>

  <gi xml:id="glossary-inferential-link">
    <title>Inferential Link, <m>I_k</m></title>

    <p>
      The mathematical relationship or reasoning rule used to connect a
      criterion to a judgment.
    </p>

    <p>
      In the episode
      <md>
        \text{a free variable exists}
        \longrightarrow
        \text{the solution is not unique},
      </md>
      the inferential link is that a system with a free variable cannot
      have exactly one solution.
    </p>

    <p>
      The inferential link is not read verbatim from a response. The
      per-question set of valid links is the project's normative
      reference, stored in the working codebook (the
      <c>normative_link</c> field of <c>question_controls</c>); the second
      correctness digit grades a response's link against that reference. A
      schema comment glosses this field with the letter <q>L</q>, but in
      the Episode Model the inferential link is always <m>I</m>, never
      <m>L</m> (which denotes the representation system).
    </p>
  </gi>

  <gi xml:id="glossary-judgment">
    <title>Judgment, <m>J_k</m></title>

    <p>
      The conclusion, classification, or decision reached in an episode.
      Examples include:
      <ul>
        <li>the system is consistent;</li>
        <li>the solution is not unique;</li>
        <li>the vector is not in the span; or</li>
        <li>the function is increasing.</li>
      </ul>
    </p>
  </gi>

  <gi xml:id="glossary-complete-episode">
    <title>Complete Episode</title>

    <p>
      An episode for which the response supplies enough evidence to
      identify a criterion, an inferential link, and a judgment.
    </p>

    <p>
      The link need not be written as a formal theorem, but it must be
      supported without requiring the coder to add new mathematical
      reasoning.
    </p>
  </gi>

  <gi xml:id="glossary-incomplete-episode">
    <title>Incomplete Episode</title>

    <p>
      An episode in which one or more of the criterion, inferential link,
      or judgment cannot be identified from the available evidence.
    </p>

    <p>
      An incomplete episode is preserved as partial evidence rather than
      repaired or forced into a complete correctness code.
    </p>
  </gi>

  <gi xml:id="glossary-explicit">
    <title>Explicit Evidence</title>

    <p>
      Evidence stated directly in the student's words, symbols, diagram,
      or calculations.
    </p>
  </gi>

  <gi xml:id="glossary-strongly-supported">
    <title>Strongly Supported Evidence</title>

    <p>
      A component that is not stated word for word but is identified
      clearly by the structure and mathematical content of the response
      without requiring the coder to add new reasoning.
    </p>
  </gi>

  <gi xml:id="glossary-missing-ambiguous">
    <title>Missing or Ambiguous Evidence</title>

    <p>
      Evidence that is not sufficiently present to support a defensible
      interpretation. Identifying the component would require guessing,
      repairing, or selecting among several plausible meanings.
    </p>
  </gi>

  <gi xml:id="glossary-paraphrasing">
    <title>Paraphrasing</title>

    <p>
      Restating the student's idea in clearer or standardized language
      without changing its mathematical content.
    </p>
  </gi>

  <gi xml:id="glossary-interpretation">
    <title>Interpretation</title>

    <p>
      Identifying the mathematical role of a statement using evidence from
      the response and the question context.
    </p>
  </gi>

  <gi xml:id="glossary-repair">
    <title>Repair</title>

    <p>
      Adding a missing condition, theorem, intermediate result, or
      conclusion so that the student's reasoning becomes mathematically
      complete.
    </p>

    <p>
      Repair is not permitted in episode extraction. Missing reasoning
      must remain recorded as missing.
    </p>
  </gi>

  <gi xml:id="glossary-segmentation">
    <title>Episode Segmentation</title>

    <p>
      The process of deciding how many episodes appear in a response and
      where the boundary between episodes occurs.
    </p>
  </gi>

  <gi xml:id="glossary-chained-episodes">
    <title>Chained Episodes</title>

    <p>
      Episodes in which the judgment of one episode becomes the criterion
      for a later episode.
    </p>

    <p>
      For example:
      <md>
        \text{fewer pivots than variables}
        \longrightarrow
        \text{a free variable exists}
        \longrightarrow
        \text{the solution is not unique}.
      </md>
    </p>
  </gi>

  <gi xml:id="glossary-independent-episodes">
    <title>Independent Episodes, <m>e_a\parallel e_b</m></title>

    <p>
      Separate justifications that do not depend on one another for coding
      purposes. A student might, for example, justify the same conclusion
      using both a pivot argument and a dimension argument.
    </p>
  </gi>

  <gi xml:id="glossary-nested-episodes">
    <title>Nested Episodes, <m>e_i\sqsubseteq e_j</m></title>

    <p>
      A relationship in which one episode functions as a sub-step within a
      larger episode or argument.
    </p>

    <p>
      Nested episodes may also be chained. The terms describe related but
      not necessarily mutually exclusive features.
    </p>
  </gi>

  <gi xml:id="glossary-nesting-policy">
    <title>Nesting Policy, <m>\pi</m></title>

    <p>
      The coding convention that determines how nested episodes are
      retained. A policy may direct coders to keep:
      <ul>
        <li>both the parent and child episodes;</li>
        <li>only the parent episode; or</li>
        <li>only the child episode.</li>
      </ul>
    </p>

    <p>
      The research team fixes this policy before validation. The
      mathematics alone does not determine it.
    </p>
  </gi>

  <gi xml:id="glossary-valid-link-set">
    <title>Valid-Inference Set, <m>\mathcal{T}</m></title>

    <p>
      The question-specific collection of inferential links regarded as
      mathematically valid for the task. An episode's inferential link is
      evaluated against this set rather than against a universal
      question-independent rule.
    </p>
  </gi>

  <gi xml:id="glossary-normative-reference">
    <title>Normative Reference</title>

    <p>
      The agreed mathematical standard used to evaluate an episode. It
      includes:
      <ul>
        <li>the true mathematical state of the problem; and</li>
        <li>
          the question-specific inferential links that validly connect
          criteria to judgments.
        </li>
      </ul>
    </p>
  </gi>

  <gi xml:id="glossary-correctness-code">
    <title>Correctness Annotation</title>

    <p>
      The two-part annotation assigned to a complete episode:
      <md>
        \operatorname{code}(e_k)=(c_k^1,c_k^2).
      </md>
      The first digit records whether the criterion is true. The second
      records whether the inferential link validly supports the judgment.
    </p>

    <p>
      The two-digit code is adapted from prior work (Gerami et&#160;al.,
      2024) and layered on top of the episode description. It is not part
      of the cK&#162; model, which does not ask whether a student's
      reasoning was right.
    </p>

    <p>
      The possible pairs are:
      <dl width="narrow">
        <li>
          <title><m>(1,1)</m></title>
          <p>True criterion and valid inferential link.</p>
        </li>

        <li>
          <title><m>(1,0)</m></title>
          <p>True criterion but invalid inferential link.</p>
        </li>

        <li>
          <title><m>(0,1)</m></title>
          <p>
            False criterion, although the general criterion-to-judgment
            relationship is valid.
          </p>
        </li>

        <li>
          <title><m>(0,0)</m></title>
          <p>False criterion and invalid inferential link.</p>
        </li>
      </dl>
    </p>
  </gi>

  <gi xml:id="glossary-criterion-correctness">
    <title>Criterion Correctness</title>

    <p>
      Whether the criterion stated in an episode is true in the actual
      mathematical situation. It is represented by the first digit
      <m>c_k^1</m> of the correctness annotation.
    </p>
  </gi>

  <gi xml:id="glossary-link-correctness">
    <title>Inferential-Link Correctness</title>

    <p>
      Whether the criterion validly supports the judgment for the
      particular question. It is represented by the second digit
      <m>c_k^2</m> of the correctness annotation.
    </p>
  </gi>

  <gi xml:id="glossary-justification-quality">
    <title>Justification Quality</title>

    <p>
      The mathematical quality of the local reasoning in an episode,
      including whether its criterion is true and its inferential link is
      valid.
    </p>
  </gi>

  <gi xml:id="glossary-goal-coverage">
    <title>Goal Coverage</title>

    <p>
      The extent to which the response addresses all conclusions or tasks
      requested by the question.
    </p>

    <p>
      Goal coverage is evaluated separately from justification quality. A
      response may contain sound local episodes but fail to answer the
      complete prompt.
    </p>
  </gi>

  <gi xml:id="glossary-response-level-evidence">
    <title>Response-Level Evidence</title>

    <p>
      Information visible in one student response that supports a limited
      interpretation of the student's reasoning.
    </p>

    <p>
      Response-level evidence is not treated as a complete model of what
      the student knows or believes across other situations.
    </p>
  </gi>

</glossary>